{
  // Default interaction corpus.
  "defaultLocale": "it",

  // Time context for Italian deployments.
  "timezone": "Europe/Rome",

  "reactionPacks": [
    "core-it",
    "custom"
  ],

  "maxReactionsPerMessage": 1,

  "passiveReactions": true,

  "commands": {
    "enabled": true
  },

  // Ambient, trigger-independent Telegram message reactions (the tap-to-react
  // emoji badge, not a reply message). emojiReactionPool must only contain
  // emoji from Telegram's fixed reaction set (see
  // app/caciarabot/config/allowed_reactions.py) -- anything else fails
  // config validation.
  "randomEvents": {
    "enabled": false,
    "emojiReactionProbability": 0.33,
    "emojiReactionPool": ["😁", "😢", "😡", "🤣", "👍", "👎", "🤡", "🗿", "🦄", "🐳", "🌚"]
  },

  // Optional Gemini-backed replies (config/prompts/replies/*.txt), a
  // once-a-day unprompted post (config/prompts/daily/*.txt), a reply
  // whenever someone directly addresses the bot -- @mention, a Telegram
  // reply to one of its own messages, or one of citedReply.triggerWords
  // (default ["caciara"], word-boundary matched, so "caciara" alone works
  // like an @mention even without the exact username) -- via
  // config/prompts/cited/*.txt, a daily digest of one CS-related link via
  // config/prompts/digest/*.txt, and a "secret" about one or two chat
  // members (built from a roster recorded as people post -- name only, no
  // message content -- since the Bot API can't list a group's full
  // membership) whenever someone says "segreto", via
  // config/prompts/secret/*.txt. citedReply always fires when the bot is
  // addressed (no probability knob); the others are
  // probability/cooldown/schedule-gated. Requires GEMINI_API_KEY in .env
  // when enabled -- the bot refuses to start otherwise. dryRun logs the
  // generated text instead of sending it, for testing without touching
  // the real chat.
  "llm": {
    "enabled": false,
    "model": "gemini-3.1-flash-lite",
    "dryRun": false,
    "reply": {
      "probability": 0.1
    },
    "dailyThought": {
      "enabled": false,
      "time": "09:00"
    },
    "citedReply": {
      "enabled": false,
      "triggerWords": ["caciara"]
    },
    "secret": {
      "enabled": false,
      "probability": 0.5,
      "cooldownSeconds": 1800
    },
    "digest": {
      "enabled": false,
      "time": "08:00",
      "sources": ["hackernews", "github_trending"]
    }
  }
}
