# CaciaraBot's only per-deployment file. Copy to .env and edit.
#
# Every CACIARABOT_* setting below is optional: leave it out and the
# built-in default applies. The defaults are a working Italian
# deployment with all LLM features off. A misspelled CACIARABOT_*
# variable is a startup error, not a silent no-op.
#
# Check your settings without connecting to Telegram:
#     uv run caciarabot-validate

# --- required -------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# Telegram user id allowed to run admin commands regardless of whether
# they are a chat admin. Leave empty to allow chat admins only.
CACIARABOT_OWNER_ID=

# Required only when CACIARABOT_LLM_ENABLED is true; the bot refuses to
# start without it.
GEMINI_API_KEY=

# --- paths (already correct for podman compose) ---------------------
CACIARABOT_CONFIG_DIR=/config
CACIARABOT_MEDIA_DIR=/media
CACIARABOT_DATA_DIR=/data
TZ=Europe/Rome

# --- general --------------------------------------------------------
# CACIARABOT_DEFAULT_LOCALE=it
# CACIARABOT_TIMEZONE=Europe/Rome
# Reaction packs to load from config/packs/, comma separated.
# CACIARABOT_REACTION_PACKS=core-it,custom
# CACIARABOT_MAX_REACTIONS_PER_MESSAGE=1
# CACIARABOT_PASSIVE_REACTIONS=true
# CACIARABOT_COMMANDS_ENABLED=true

# --- ambient emoji reactions ----------------------------------------
# The tap-to-react emoji badge, not a reply message. The pool may only
# contain emoji from Telegram's fixed reaction set (see
# app/caciarabot/config/allowed_reactions.py) -- anything else is a
# startup error.
# CACIARABOT_EMOJI_REACTIONS_ENABLED=false
# CACIARABOT_EMOJI_REACTION_PROBABILITY=0.33
# CACIARABOT_EMOJI_REACTION_POOL=😁,😢,😡,🤣,👍,👎,🤡,🗿,🦄,🐳,🌚

# --- Gemini-backed features -----------------------------------------
# Master switch. Everything below it is inert while this is false.
# dryRun logs the generated text instead of sending it.
# CACIARABOT_LLM_ENABLED=false
# CACIARABOT_LLM_MODEL=gemini-3.1-flash-lite
# CACIARABOT_LLM_DRY_RUN=false

# Ambient replies to ordinary messages (config/prompts/replies/).
# CACIARABOT_LLM_REPLY_PROBABILITY=0.1

# One unprompted post a day (config/prompts/daily/, daily_depth/,
# daily_style/). LINK_PROBABILITY of those instead comment on a random
# Wikipedia article (config/prompts/daily_link/) in one of
# LINK_LANGUAGES, always answering in Italian. A failed generation falls
# back to config/fallback/daily.txt rather than skipping the day.
# CACIARABOT_LLM_DAILY_THOUGHT_ENABLED=false
# CACIARABOT_LLM_DAILY_THOUGHT_TIME=09:00
# CACIARABOT_LLM_DAILY_LINK_PROBABILITY=0.2
# CACIARABOT_LLM_DAILY_LINK_LANGUAGES=it,en

# Reply whenever the bot is directly addressed -- @mention, a Telegram
# reply to one of its own messages, or one of the trigger words
# (word-boundary matched, so "caciara" works like an @mention even
# without the exact username). Always fires; no probability knob.
# CACIARABOT_LLM_CITED_REPLY_ENABLED=false
# CACIARABOT_LLM_CITED_TRIGGER_WORDS=caciara

# Invented "secret" about one or two chat members whenever someone says
# "segreto", built from a roster of who has posted (names only, no
# message content -- the Bot API can't list a group's membership).
# CACIARABOT_LLM_SECRET_ENABLED=false
# CACIARABOT_LLM_SECRET_PROBABILITY=0.5
# CACIARABOT_LLM_SECRET_COOLDOWN_SECONDS=1800

# Daily digest of one CS-related link. reddit is supported but not a
# default: its public .json endpoints commonly 403 unauthenticated
# clients, so it has to be opted into explicitly.
# CACIARABOT_DIGEST_ENABLED=false
# CACIARABOT_DIGEST_TIME=08:00
# CACIARABOT_DIGEST_SOURCES=hackernews,github_trending
# CACIARABOT_DIGEST_REDDIT_SUBS=programming
