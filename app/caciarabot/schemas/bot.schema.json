{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://caciarabot.local/schemas/bot.schema.json",
  "title": "CaciaraBot global configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultLocale", "reactionPacks"],
  "properties": {
    "defaultLocale": { "type": "string", "minLength": 2 },
    "timezone": { "type": "string" },
    "reactionPacks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "maxReactionsPerMessage": { "type": "integer", "minimum": 0 },
    "passiveReactions": { "type": "boolean" },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "randomEvents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "emojiReactionProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "emojiReactionPool": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "model": { "type": "string", "minLength": 1 },
        "dryRun": { "type": "boolean" },
        "reply": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "probability": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "dailyThought": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
          }
        },
        "citedReply": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "sources": {
              "type": "array",
              "items": { "enum": ["hackernews", "github_trending", "reddit"] },
              "minItems": 1
            },
            "redditSubs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
