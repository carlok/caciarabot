{
  // Default interaction corpus.
  "defaultLocale": "it",

  // Time context for Italian deployments.
  "timezone": "Europe/Rome",

  "reactionPacks": [
    "core-it",
    "custom"
  ],

  "maxReactionsPerMessage": 1,

  "passiveReactions": true,

  "commands": {
    "enabled": true
  },

  // Ambient, trigger-independent Telegram message reactions (the tap-to-react
  // emoji badge, not a reply message). emojiReactionPool must only contain
  // emoji from Telegram's fixed reaction set (see
  // app/caciarabot/config/allowed_reactions.py) -- anything else fails
  // config validation.
  "randomEvents": {
    "enabled": false,
    "emojiReactionProbability": 0.33,
    "emojiReactionPool": ["😁", "😢", "😡", "🤣", "👍", "👎", "🤡", "🗿", "🦄", "🐳", "🌚"]
  },

  // Optional Gemini-backed replies (config/prompts/replies/*.txt), a
  // once-a-day unprompted post (config/prompts/daily/*.txt), a reply
  // whenever someone directly addresses the bot -- @mention or a Telegram
  // reply to one of its own messages -- via config/prompts/cited/*.txt,
  // and a daily digest of one CS-related link (Hacker News / GitHub
  // trending) with a short LLM comment via config/prompts/digest/*.txt.
  // citedReply always fires when the bot is addressed (no probability
  // knob); the others are probability/schedule-gated. Requires
  // GEMINI_API_KEY in .env when enabled -- the bot refuses to start
  // otherwise. dryRun logs the generated text instead of sending it, for
  // testing without touching the real chat.
  "llm": {
    "enabled": false,
    "model": "gemini-3.1-flash-lite",
    "dryRun": false,
    "reply": {
      "probability": 0.1
    },
    "dailyThought": {
      "enabled": false,
      "time": "09:00"
    },
    "citedReply": {
      "enabled": false
    },
    "digest": {
      "enabled": false,
      "time": "08:00",
      "sources": ["hackernews", "github_trending"]
    }
  }
}
