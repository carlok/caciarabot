{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://caciarabot.local/schemas/bot.schema.json",
  "title": "CaciaraBot global configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultLocale", "reactionPacks"],
  "properties": {
    "defaultLocale": { "type": "string", "minLength": 2 },
    "timezone": { "type": "string" },
    "reactionPacks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "maxReactionsPerMessage": { "type": "integer", "minimum": 0 },
    "passiveReactions": { "type": "boolean" },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "randomEvents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "emojiReactionProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "emojiReactionPool": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    }
  }
}
